# Gigi Environment Configuration
# Copy this file to .env and fill in your values.

# --- LLM API Keys ---
OPENAI_API_KEY=your_openai_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# Note: AZURE_OPENAI_KEY is also accepted as fallback
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- Robot Networking & Deployment ---
# IP address of the physical Gigi robot (Orange Pi) on your local network
# ROBOT_IP=192.168.1.50
ROBOT_USER=orangepi
ROBOT_REMOTE_PATH=/home/orangepi/Code/gigi

# --- Daemon / Server Settings ---
TCP_PORT=5005
RFCOMM_CHANNEL=1
FLASK_PORT=5000

# --- Hardware Overrides (optional) ---
# Set to 'true' or 'false' to force hardware simulation or enable/disable subsystems
# GIGI_IS_ROBOT=false
# GIGI_USE_NPU=false
